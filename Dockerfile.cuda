# flodl CUDA image -- CUDA toolkit only, libtorch mounted at runtime.
#
# No libtorch is baked into this image. Mount the appropriate variant
# from libtorch/ via docker-compose volumes.
#
# The CUDA toolkit version is parameterized. Override at build time:
#   docker build --build-arg CUDA_VERSION=12.6.0 -f Dockerfile.cuda .

ARG CUDA_VERSION=12.8.0
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    unzip \
    ca-certificates \
    git \
    gcc \
    g++ \
    pkg-config \
    graphviz \
    openssh-client \
    openssh-server \
    # rsync: this image runs sshd, so it can BE a join door, and door `b`
    # serves its source pull through rrsync (shipped in the rsync
    # package) as the key's forced command. Without it the door
    # authenticates and then fails with sshd's least helpful error.
    rsync \
    # python3: Ubuntu's rrsync is a python3 script, so the interpreter is
    # part of the door working, not an extra.
    python3-minimal \
    && rm -rf /var/lib/apt/lists/*

# --- sshd setup for the `cuda-rank` compose service ---
# Used only when the launcher dispatches into this container as a remote
# host (treating the container as a VM-equivalent — own SSH endpoint,
# fresh process tree, no fork+exec inheritance from a co-resident
# launcher). The base `cuda` compose service is unaffected; only
# `cuda-rank` boots sshd via its `command:`.
#
# Listen on 2222 (avoids clash with the host's sshd on 22 when
# `network_mode: host`). Key auth only. Host keys live in a volume so
# they persist across container restarts.
RUN mkdir -p /var/run/sshd /home/ubuntu/.ssh \
    && chown ubuntu:ubuntu /home/ubuntu/.ssh \
    && chmod 700 /home/ubuntu/.ssh \
    && sed -i 's/^#\?Port .*/Port 2222/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PubkeyAuthentication .*/PubkeyAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PermitRootLogin .*/PermitRootLogin no/' /etc/ssh/sshd_config \
    && echo 'AllowUsers ubuntu' >> /etc/ssh/sshd_config \
    && echo 'AcceptEnv FLODL_* FDL_ENV LD_LIBRARY_PATH' >> /etc/ssh/sshd_config

# --- Rust ---
ENV CARGO_HOME="/usr/local/cargo"
ENV RUSTUP_HOME="/usr/local/rustup"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && chmod -R a+rwx "$CARGO_HOME" "$RUSTUP_HOME"
ENV PATH="${CARGO_HOME}/bin:${PATH}"

# --- Coverage tooling (`fdl coverage-all` phases 2-4 run in this image) ---
# See the same block in Dockerfile: CARGO_HOME/bin is not a mounted
# volume, so an ad-hoc install cannot survive the container.
RUN rustup component add llvm-tools-preview \
    && cargo install cargo-llvm-cov --locked \
    && chmod -R a+rwx "$CARGO_HOME" "$RUSTUP_HOME"

# libtorch is bind-mounted at runtime to /usr/local/libtorch
ENV LIBTORCH_PATH="/usr/local/libtorch"
ENV LD_LIBRARY_PATH="${LIBTORCH_PATH}/lib:/usr/local/cuda/lib64"
ENV LIBRARY_PATH="${LIBTORCH_PATH}/lib:/usr/local/cuda/lib64"
ENV CUDA_HOME="/usr/local/cuda"

WORKDIR /workspace
