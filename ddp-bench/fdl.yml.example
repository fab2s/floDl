description: DDP validation and benchmark suite
docker: gpu
# Cargo entry: `compile: true` lets fdl auto-probe the binary's own
# `--fdl-schema` output, so `fdl ddp-bench --help` (and tab-completion) reflect
# the actual CLI — the binary is the single source of truth, no hand-written
# schema to drift out of sync with the code. The first `-h` after this file OR
# any of the crate's sources change compiles once in the GPU container; the
# result is then cached (.fdl/schema-cache/, gitignored) and subsequent `-h`
# are fast. Adding a flag therefore shows up in `-h` on its own — no yml touch,
# no manual cache delete.
compile: true
entry: cargo run --release --features "$FDL_GPU_FEATURE" --

# Default LRs per model (for reference):
#   linear=0.001  mlp=0.001  convnet=0.001  lstm=0.001
#   transformer=0.0005  autoencoder=0.001  residual=0.0003
#   moe=0.001  feedback=0.001
# LR auto-scales when --epochs > 5: lr = default * (5 / epochs)
# Override with --lr-scale <F> to multiply all LRs explicitly.
training:
  epochs: 5
  seed: 42

output:
  dir: runs/

commands:
  quick:
    description: Fast smoke test (logistic, 1 epoch)
    training: { epochs: 1 }
    options: { model: logistic, mode: solo-0, batches: 100 }

  full-sweep:
    description: All models, all DDP modes
    options: { model: all, mode: all }

  solo-0:
    description: Solo baseline on fast GPU (all models)
    options: { model: all, mode: solo-0 }

  solo-1:
    description: Solo baseline on slow GPU (all models)
    options: { model: all, mode: solo-1 }

  solo-2:
    description: Solo baseline on second slow GPU (all models, 3-GPU rigs)
    options: { model: all, mode: solo-2 }

  nccl-cadence:
    description: NCCL cadence for all models
    options: { model: all, mode: nccl-cadence }

  validate:
    description: Check convergence against structured baselines
    options: { model: all, mode: all, validate: true, baseline: baselines/structured.json }

  report:
    description: Generate convergence report from timeline data
    options: { report: runs/report.md }
