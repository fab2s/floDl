# Multi-host cluster overlay -- deep-merges onto fdl.yml.
#
# Usage:
#   cp fdl.cluster.yml.example fdl.cluster.yml
#   # edit `controller:` + `workers:` sections to match your rig
#   fdl cluster <command>      # activates this overlay (first-arg env convention)
#   FDL_ENV=cluster fdl <cmd>  # equivalent
#
# Schema (Refactor 2): strict separation of `controller:` (the
# orchestrator host fdl-cli runs on, NEVER a NCCL rank) and `workers:`
# (every rank-carrying host).
#
# Conventions:
#   - This file lives alongside fdl.yml. fdl-cli's overlay mechanism
#     picks it up when invoked as `fdl cluster <cmd>` (first arg =
#     overlay name) or with `FDL_ENV=cluster` set in the environment.
#   - One process per rank. Each worker owns one rank per visible CUDA
#     device. Global rank IDs are NOT user input — fdl probes each host
#     for its device count before fan-out and assigns ranks sequentially
#     by worker order: worker 0 owns [0..N0), worker 1 owns [N0..N0+N1),
#     etc. The probe queries `nvidia-smi --query-gpu=index --format=csv,noheader`
#     via SSH for workers using `local_devices: all`.
#   - `local_devices:` accepts either an explicit list (`[0, 1]`) or
#     the `all` shorthand. With `all`, fdl probes the host's GPU count
#     before dispatch; explicit lists carry their own count. A 0-GPU
#     result on a worker using `all` aborts dispatch with a clear error
#     (likely misconfig — switch to an explicit `[0, 1, ...]` list).
#   - `nccl_socket_ifname:` is required on every worker when the
#     cluster spans multiple machines. NCCL needs it to bind its TCP
#     transport; auto-detection is brittle so fdl errors loudly if
#     missing.
#   - `host:` is the worker identifier (was `name:` pre-Refactor 2).
#     Used for /etc/hosts resolution, `--add-host` injection, and as
#     the default SSH target.
#   - `ssh:` is a launcher-only sub-block that groups all SSH knobs for
#     this worker. fdl-cli uses it to connect; flodl itself only reads
#     `ssh.target` to know the network endpoint. Omit the whole block
#     to skip overrides (default target = `host:`, defaults for
#     port/user/identity/options come from system ssh +
#     `~/.ssh/config`). Sub-fields:
#       target:        ssh hostname/IP/alias (default: `host:`)
#       port:          maps to `ssh -p <port>`
#       user:          maps to `ssh -l <user>`
#       identity_file: maps to `ssh -i <path>`
#       options:       list of `-o Key=Value` directives, e.g.
#                      `["ProxyJump=bastion", "StrictHostKeyChecking=no"]`
#   - `path:` is the project checkout dir on this host. fdl-cli cd's
#     here before invoking the remote command. Heterogeneous mounts
#     are fine (e.g. `/opt/flodl` on the controller, `/srv/flodl` in a
#     VM); training data is the user's responsibility to mount
#     identically across hosts (NAS / SMB / virtiofs / S3-FUSE).
#   - `arch:` is the libtorch variant subpath under `<path>/libtorch/`
#     on this host. E.g. `precompiled/cu128` (PT cu128 wheels) or
#     `builds/sm61-sm120` (a from-source build). The convention path
#     `<path>/libtorch/<arch>` is what the rank reads at runtime; the
#     controller-side build (pre-flight) mirrors it via
#     `<controller.path>/libtorch/<controller.arch>`. Both point at
#     the same physical libtorch via the shared project-root mount.
#
#     For heterogeneous rigs, each worker's `arch:` selects a
#     different variant (e.g. Blackwell host on `precompiled/cu128`,
#     Pascal host on `builds/sm61-sm120`) -- the convention keeps the
#     path stable while the variant differs per host.
#
#     `fdl probe`'s GPU compat check derives supported sm
#     architectures by basename parsing (e.g. `builds/sm61-sm120` ->
#     `6.1 12.0`) plus reading the variant's `.arch` metadata file at
#     `<path>/libtorch/<arch>/.arch`.
#   - `docker:` (optional) names the docker-compose service this host
#     runs training inside (e.g. `cuda`, `dev`). Per-host, NOT global:
#     mixed deployments (controller in Docker, worker bare-metal) are
#     common. `fdl probe` uses it to skip host-level NCCL scanning
#     (NCCL ships in the container image) and reports "via Docker
#     image <svc>" instead of erroring on a missing libnccl.so on the
#     host. Omit when the host runs flodl natively.
#
# `controller.port:` defaults to 1337 when omitted (replaces
# PyTorch's MASTER_PORT default of 29500). Port `+1` is reserved for
# the dashboard side-channel; `+2` / `+3` host ClusterController /
# ClusterCoordinator. Pick a base port that leaves the `+3` slot free.

cluster:
  controller:
    host: 192.168.122.1               # rendezvous bind address (was `master_addr`)
    port: 1337                        # rendezvous port (was `master_port`); default 1337
    path: /opt/flodl                  # controller's view of the shared project root
    # docker: cuda                    # optional pre-flight build context
    # arch: precompiled/cu128         # optional libtorch variant for pre-flight

  workers:
    - host: node-a                    # worker identifier; default SSH target
      local_devices: [0]              # 1 device -> 1 rank, assigned [0]
      nccl_socket_ifname: virbr0
      path: /opt/flodl                # checkout path on this worker
      arch: precompiled/cu128         # libtorch variant under <path>/libtorch/
      docker: cuda                    # training runs in the `cuda` compose service;
                                      # omit when this worker runs flodl natively.

    - host: node-b
      ssh:                            # optional sub-block; omit entirely to use defaults
        target: node-b                # ssh target; defaults to host: if omitted
        # port: 2222
        # user: fab2s
        # identity_file: /home/fab2s/.ssh/cluster_key
        # options:
        #   - ProxyJump=bastion
        #   - StrictHostKeyChecking=no
      local_devices: all              # probed pre-dispatch; equivalent to [0, 1]
                                      # if this worker has 2 visible CUDA devices.
                                      # Resulting ranks: [1, 2] (sequential after node-a's [0]).
      nccl_socket_ifname: enp1s0
      path: /srv/flodl                # heterogeneous mounts are fine
      arch: builds/sm61-sm120         # different variant per worker is OK
                                      # no `docker:` here -> bare-metal flodl install.
      # Optional per-worker env vars exported into every rank child
      # spawned on this worker. Overrides cluster-scope `env:` for
      # matching keys. Example: older consumer-grade GPUs under VFIO
      # that need NCCL fallback transport.
      # env:
      #   NCCL_P2P_DISABLE: "1"
      #   NCCL_SHM_DISABLE: "1"

  # Cluster-scope env: applied to every rank child on every worker.
  # Per-worker `env:` blocks override matching keys.
  # env:
  #   NCCL_DEBUG: INFO
