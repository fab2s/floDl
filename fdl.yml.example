description: flodl - Rust deep learning framework

commands:
  # --- Sub-command (child fdl.yml) ---
  ddp-bench:                    # convention: ./ddp-bench/fdl.yml
  flodl-hf:                     # convention: ./flodl-hf/fdl.yml
  hf-ddp:                 # convention: ./hf-ddp/fdl.yml (flodl-hf DDP validation vehicle)

  # --- CPU targets ---
  build:
    description: Build (debug)
    run: cargo build
    docker: dev
  test:
    description: Run all CPU tests
    run: cargo test
    append: -- --nocapture --skip leakcheck
    docker: dev
  test-release:
    description: Run tests in release mode
    run: cargo test --release
    append: -- --nocapture --skip leakcheck
    docker: dev
  test-live:
    description: Run live tests (network / external resources; `#[ignore]` + name ending in `_live`)
    run: cargo test live
    append: -- --nocapture --ignored
    docker: dev
  leak-test:
    description: Run the process-global leak tests single-threaded (name contains `leakcheck`)
    run: cargo test leakcheck
    append: -- --nocapture --test-threads=1
    docker: dev
  check:
    description: Type check without building
    run: cargo check
    docker: dev
  clippy:
    description: Lint (all targets incl. tests + examples, workspace + ddp-bench)
    run: cargo clippy --all-targets -- -W clippy::all && cd ddp-bench && cargo clippy --tests -- -W clippy::all
    docker: dev
  doc:
    description: Generate API docs (strict, fails on warnings)
    run: RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --document-private-items && test -f target/doc/flodl/index.html
    docker: dev
  ci:
    description: Run the full CI CPU job locally (build + test + clippy + doc)
    run: cargo build && cargo test -- --nocapture --skip leakcheck && cargo test leakcheck -- --test-threads=1 --nocapture && cargo clippy --all-targets -- -W clippy::all && RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --document-private-items && test -f target/doc/flodl/index.html
    docker: dev
  shell:
    description: Interactive shell in dev container
    run: bash
    docker: dev

  # --- CUDA targets ---
  cuda-build:
    description: Build with CUDA feature
    run: cargo build --features cuda
    docker: cuda
  # Scoping: -p flodl -p flodl-hf — only crates that carry the `cuda`
  # feature have CUDA tests. flodl-cli / flodl-cli-macros are config +
  # dispatch (no GPU code, no CUDA tests); flodl-sys has no tests at
  # all. Without `-p` cargo would still compile + invoke their test
  # binaries on every pass, filter everything out, and dump hundreds
  # of `running 0 tests` lines into the output.
  cuda-test:
    description: Run CUDA tests (parallel, excludes NCCL/Graph)
    run: cargo test -p flodl -p flodl-hf --features cuda
    append: -- --nocapture
    docker: cuda
  cuda-test-all:
    description: Full CUDA suite (parallel + NCCL isolated + serial)
    run: cargo test -p flodl -p flodl-hf --features cuda -- --nocapture && cargo test -p flodl -p flodl-hf --features cuda -- --nocapture --ignored --test-threads=1 nccl && cargo test -p flodl -p flodl-hf --features cuda -- --nocapture --ignored --test-threads=1 graph_distribute && cargo test -p flodl -p flodl-hf --features cuda -- --nocapture --ignored --test-threads=1 --skip nccl --skip graph_distribute --skip _live
    docker: cuda
  cuda-test-nccl:
    description: NCCL/DDP tests only (isolated processes)
    run: cargo test -p flodl -p flodl-hf --features cuda -- --nocapture --ignored --test-threads=1 nccl && cargo test -p flodl -p flodl-hf --features cuda -- --nocapture --ignored --test-threads=1 graph_distribute
    docker: cuda
  cuda-test-serial:
    description: Serial CUDA tests (Graphs, manual_seed, probes)
    run: cargo test -p flodl -p flodl-hf --features cuda -- --nocapture --ignored --test-threads=1 --skip nccl --skip graph_distribute --skip _live
    docker: cuda
  cuda-test-graph:
    description: CUDA Graph tests only (exclusive GPU, single-threaded)
    run: cargo test -p flodl -p flodl-hf --features cuda -- --nocapture --ignored --test-threads=1 cuda_graph
    docker: cuda
  cuda-clippy:
    description: Lint with CUDA feature (all targets incl. tests + examples, workspace + ddp-bench)
    run: cargo clippy --features cuda --all-targets -- -W clippy::all && cd ddp-bench && cargo clippy --tests --features cuda -- -W clippy::all
    docker: cuda
  cuda-shell:
    description: Interactive shell in CUDA container
    run: bash
    docker: cuda

  # --- Benchmarks (see ./benchmarks/fdl.yml) ---
  bench:
    path: ./benchmarks/

  # --- fdl CLI ---
  self-build:
    description: Rebuild fdl CLI after changes
    run: cargo install --path flodl-cli

# ---------------------------------------------------------------------------
# join: worker-side dial-in defaults for `fdl join` (self-deployed
# workers walking into a controller's join window — the mirror image of
# a cluster overlay's `controller.join:`). Bake it into a golden image
# so a boot-time `fdl join` needs no flags; every field is overridable
# on the command line (flags win). See docs/ddp.md "Walking in".
# ---------------------------------------------------------------------------
# join:
#   controller: 10.0.0.1:1337       # controller mux address, host[:port]
#                                   # (under ssh: as seen FROM the ssh host;
#                                   # default 127.0.0.1:1337)
#   ssh:                            # optional tunnel hop: local `-L` forward
#     target: ctrl.example.com      # of the controller port through this host
#     user: flodl-join
#     identity_file: /etc/flodl/join_key
#     # port: 22
#     # options: ["StrictHostKeyChecking=accept-new"]
#   token: <hex>                    # pre-shared credential (the run's
#                                   # controller.join.token); unset = open admission
#   bin: target/release/train       # training binary run in agent role (required)
#   args: ["--model", "resnet"]     # the binary's own arguments (a `--` tail
#                                   # on the command line replaces this list)
#   # host: worker-7                # logical roster name (default: hostname)
#   # devices: [0, 1]               # CUDA ids to offer (default: all GPUs)
#   # persist: true                 # re-dial with backoff when the agent
#   #                               # exits — the systemd / fleet mode
